constexpr bool InRange(int my_hq_level, int enemy_hq_level,
                       int base_level, int garrison_count,
                       int attacker_count) {
  return 1 <= my_hq_level && my_hq_level <= kMyHqLevels &&
         1 <= enemy_hq_level && enemy_hq_level <= kEnemyHqLevels &&
         1 <= base_level && base_level <= kBaseLevels &&
         0 <= garrison_count && garrison_count <= kMaxGarrison &&
         1 <= attacker_count && attacker_count <= kMaxAttackers;
}

constexpr std::size_t Index(int my_hq_level, int enemy_hq_level,
                            int base_level, int garrison_count,
                            int attacker_count) {
  return (((((static_cast<std::size_t>(my_hq_level - 1) * 5 +
              (enemy_hq_level - 1)) * 3 + (base_level - 1)) * 21 +
            garrison_count) * 40) + (attacker_count - 1));
}

constexpr Outcome Get(int my_hq_level, int enemy_hq_level,
                      int base_level, int garrison_count,
                      int attacker_count) {
  if (!InRange(my_hq_level, enemy_hq_level, base_level,
               garrison_count, attacker_count))
    return {false, -1, 0};
  const std::uint16_t packed = kPacked[Index(
      my_hq_level, enemy_hq_level, base_level, garrison_count,
      attacker_count)];
  if (packed == kFailed) return {false, -1, 0};
  return {true, static_cast<int>(packed >> 8),
          static_cast<int>(packed & 0xff)};
}

